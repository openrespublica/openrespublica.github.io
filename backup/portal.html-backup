<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ORP Engine | Operator Portal</title>
    <style>
        body { background:#F0F2F5; }

        /* ── TOPBAR ── */
        .topbar { background:var(--navy-deep); border-bottom:3px solid var(--gold); position:sticky; top:0; z-index:100; }
        .topbar-inner { max-width:1100px; margin:0 auto; padding:0.75rem 1.5rem; display:flex; align-items:center; justify-content:space-between; }
        .brand { display:flex; align-items:center; gap:0.85rem; }
        .brand-badge { width:36px;height:36px;background:var(--gold);border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0; }
        .brand h1 { font-family:var(--font-serif);font-size:1rem;font-weight:700;color:#fff;line-height:1.1; }
        .brand p { font-size:0.62rem;color:rgba(201,168,76,0.8);letter-spacing:0.08em;text-transform:uppercase; }
        .topbar-right { display:flex;align-items:center;gap:0.5rem;font-size:0.75rem;color:rgba(255,255,255,0.6); }
        .status-dot { width:8px;height:8px;border-radius:50%;background:#22C55E;animation:pulse 2s infinite; }
        @keyframes pulse { 0%,100%{opacity:1}50%{opacity:0.35} }

        /* ── LAYOUT ── */
        .layout { max-width:1100px; margin:0 auto; width:100%; padding:1.5rem; display:grid; grid-template-columns:220px 1fr; gap:1.5rem; flex:1; }

        /* ── SIDEBAR ── */
        .sidebar { display:flex;flex-direction:column;gap:0.35rem; }
        .sidebar-section { font-size:0.58rem;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:var(--muted);padding:0 0.75rem;margin-top:0.85rem;margin-bottom:0.15rem; }
        .sidebar-section:first-child { margin-top:0; }
        .nav-item { display:flex;align-items:center;gap:0.75rem;padding:0.6rem 0.75rem;border-radius:8px;cursor:pointer;font-size:0.85rem;color:var(--muted);transition:all 0.15s;border:none;background:none;width:100%;text-align:left;text-decoration:none; }
        .nav-item:hover { background:rgba(0,33,71,0.06);color:var(--navy-mid); }
        .nav-item.active { background:var(--navy-deep);color:var(--gold);font-weight:600; }
        .nav-icon { width:18px;text-align:center;flex-shrink:0;font-size:0.95rem; }
        .nav-badge { margin-left:auto;font-size:0.6rem;background:var(--gold);color:var(--navy-deep);padding:1px 6px;border-radius:10px;font-weight:700; }

        /* ── PANEL ── */
        .panel { background:#fff;border:1px solid var(--border);border-radius:12px;overflow:hidden;display:none; }
        .panel.active { display:block;animation:panelIn 0.22s ease; }
        @keyframes panelIn { from{opacity:0;transform:translateY(5px)} to{opacity:1;transform:translateY(0)} }
        .panel-header { padding:1.25rem 1.5rem;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:0.75rem;background:rgba(0,33,71,0.02); }
        .panel-icon { width:36px;height:36px;background:var(--navy-deep);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:1rem;flex-shrink:0; }
        .panel-title { font-family:var(--font-serif);font-size:1.05rem;color:var(--navy-mid); }
        .panel-subtitle { font-size:0.75rem;color:var(--muted);margin-top:0.1rem; }
        .panel-body { padding:1.5rem; }

        /* ── FORM ── */
        .form-group { margin-bottom:1.15rem; }
        .form-label { display:block;font-size:0.68rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:var(--navy-mid);margin-bottom:0.35rem; }
        .form-input,.form-select,.form-textarea { width:100%;padding:0.68rem 0.9rem;border:1.5px solid rgba(0,33,71,0.15);border-radius:8px;font-family:var(--font-sans);font-size:0.875rem;color:var(--ink);background:var(--white);outline:none;transition:border-color 0.2s; }
        .form-input:focus,.form-select:focus,.form-textarea:focus { border-color:var(--navy-mid); }
        .form-textarea { resize:vertical;min-height:120px;font-family:var(--font-mono);font-size:0.75rem; }
        .form-hint { font-size:0.7rem;color:var(--muted);margin-top:0.25rem;line-height:1.5; }
        .form-grid { display:grid;grid-template-columns:1fr 1fr;gap:1rem; }

        /* ── FILE DROP ── */
        .file-drop { border:2px dashed rgba(0,51,102,0.22);border-radius:10px;padding:2.25rem 1.5rem;text-align:center;cursor:pointer;transition:all 0.2s;background:rgba(0,33,71,0.02); }
        .file-drop:hover,.file-drop.dragover { border-color:var(--navy-mid);background:rgba(0,51,102,0.04); }
        .file-drop-icon { font-size:1.75rem;margin-bottom:0.4rem; }
        .file-drop p { font-size:0.83rem;color:var(--muted); }
        .file-drop strong { color:var(--navy-mid); }

        /* ── SUBMIT ── */
        .btn-submit { width:100%;padding:0.82rem;background:var(--navy-mid);color:#fff;border:none;border-radius:8px;font-family:var(--font-sans);font-size:0.92rem;font-weight:600;cursor:pointer;letter-spacing:0.03em;transition:background 0.2s,transform 0.1s;margin-top:0.5rem; }
        .btn-submit:hover { background:var(--navy); }
        .btn-submit:active { transform:scale(0.99); }
        .btn-submit:disabled { opacity:0.5;cursor:not-allowed; }
        .btn-ghost { padding:0.55rem 1rem;background:transparent;color:var(--navy-mid);border:1.5px solid rgba(0,51,102,0.22);border-radius:8px;font-family:var(--font-sans);font-size:0.83rem;font-weight:600;cursor:pointer;transition:all 0.15s;width:100%;margin-bottom:0.75rem; }
        .btn-ghost:hover { background:rgba(0,33,71,0.06); }

        /* ── PROGRESS ── */
        .progress-wrap { display:none;margin-top:1.25rem; }
        .progress-steps { display:flex;gap:0;margin-bottom:0.75rem; }
        .progress-step { flex:1;text-align:center;font-size:0.68rem;color:var(--muted);position:relative;padding-top:0.4rem; }
        .progress-step::before { content:'';width:22px;height:22px;border-radius:50%;background:#E5E7EB;border:2px solid #E5E7EB;display:block;margin:0 auto 0.35rem;font-size:0.62rem;font-weight:700;color:#fff;line-height:18px; }
        .progress-step.done::before { background:#1E7A3E;border-color:#1E7A3E;content:'✓'; }
        .progress-step.active::before { background:var(--navy-mid);border-color:var(--navy-mid);content:'…';animation:pulse 1s infinite; }
        .progress-step.done { color:#1E7A3E; }
        .progress-step.active { color:var(--navy-mid);font-weight:600; }
        .progress-bar-wrap { height:3px;background:#E5E7EB;border-radius:2px;overflow:hidden; }
        .progress-bar { height:100%;background:var(--navy-mid);border-radius:2px;transition:width 0.5s ease;width:0%; }

        /* ── RESULT ── */
        .result-box { display:none;margin-top:1.25rem;border-radius:10px;overflow:hidden;animation:panelIn 0.3s ease; }
        .result-success { border:1.5px solid #1E7A3E; }
        .result-error   { border:1.5px solid #C62828; }
        .result-header { padding:0.8rem 1.2rem;display:flex;align-items:center;gap:0.65rem; }
        .result-success .result-header { background:#1E7A3E; }
        .result-error   .result-header { background:#C62828; }
        .result-header h4 { font-family:var(--font-serif);font-size:0.92rem;color:#fff;font-weight:700; }
        .result-body { padding:1rem 1.2rem;font-size:0.82rem; }
        .result-success .result-body { background:#F0FAF4;color:#0F4D25; }
        .result-error   .result-body { background:#FEF2F2;color:#7F1D1D; }
        .result-kv { display:grid;grid-template-columns:130px 1fr;gap:0.25rem 0.65rem;margin-top:0.5rem; }
        .result-key { font-size:0.62rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);padding-top:2px; }
        .result-val { font-family:var(--font-mono);font-size:0.7rem;word-break:break-all;color:var(--ink); }
        .download-btn { display:inline-flex;align-items:center;gap:0.4rem;margin-top:0.75rem;padding:0.45rem 1.1rem;background:#1E7A3E;color:#fff;border-radius:6px;font-size:0.8rem;font-weight:600;text-decoration:none;cursor:pointer;border:none; }

        /* ── STATS ── */
        .stats-row { display:grid;grid-template-columns:repeat(4,1fr);gap:0.85rem; }

        /* ── ALERT ── */
        .alert { padding:0.7rem 0.9rem;border-radius:8px;font-size:0.8rem;margin-bottom:1rem;display:flex;align-items:flex-start;gap:0.5rem;line-height:1.55; }
        .alert-info    { background:#EFF6FF;color:#1E40AF;border:1px solid rgba(30,64,175,0.18); }
        .alert-warning { background:#FFFBEB;color:#92400E;border:1px solid rgba(146,64,14,0.18); }

        /* ── OR DIVIDER ── */
        .or-divider { display:flex;align-items:center;gap:0.75rem;margin:0.85rem 0;color:var(--muted);font-size:0.72rem; }
        .or-divider::before,.or-divider::after { content:'';flex:1;height:1px;background:var(--border); }

        /* ── LEDGER TABLE ── */
        .table-footer { display:flex;align-items:center;justify-content:space-between;padding:0.7rem 1rem;background:rgba(0,33,71,0.02);border-top:1px solid var(--border);font-size:0.75rem;color:var(--muted);flex-wrap:wrap;gap:0.5rem; }
        .page-btn { padding:3px 10px;border:1px solid var(--border);border-radius:5px;background:#fff;font-family:var(--font-sans);font-size:0.75rem;color:var(--navy-mid);cursor:pointer;transition:background 0.15s; }
        .page-btn:disabled { opacity:0.4;cursor:default; }
        .page-btn:not(:disabled):hover { background:rgba(0,33,71,0.06); }

        @media(max-width:768px){ .layout{grid-template-columns:1fr;} .sidebar{flex-direction:row;flex-wrap:wrap;} .stats-row{grid-template-columns:1fr 1fr;} .form-grid{grid-template-columns:1fr;} }
    </style>
</head>
<body>

    <div class="topbar">
        <div class="topbar-inner">
            <div class="brand">
                <div class="brand-badge">🏛️</div>
                <div>
                    <h1>ORP Engine</h1>
                    <p>OpenResPublica TruthChain · Operator Portal</p>
                </div>
            </div>
            <div class="topbar-right">
                <div class="status-dot"></div>
                <span>Engine Online</span>
                &nbsp;·&nbsp;
                <a href="/logout" style="color:rgba(201,168,76,0.8);text-decoration:none;">Logout</a>
            </div>
        </div>
    </div>

    <div class="layout">

        <!-- ── SIDEBAR ── -->
        <aside class="sidebar">
            <div class="sidebar-section">Operations</div>
            <button class="nav-item active" onclick="showPanel('upload', this)">
                <span class="nav-icon">📄</span> PDF Stamp &amp; Anchor
            </button>
            <button class="nav-item" onclick="showPanel('ingest', this)">
                <span class="nav-icon">🪪</span> PhilID Ingest
                <span class="nav-badge">NEW</span>
            </button>

            <div class="sidebar-section">Audit</div>
            <button class="nav-item" onclick="showPanel('ledger', this)">
                <span class="nav-icon">📋</span> Local Ledger
            </button>
            <a class="nav-item" href="https://openrespublica.github.io/records.html" target="_blank">
                <span class="nav-icon">🌐</span> Public Ledger ↗
            </a>
            <a class="nav-item" href="https://openrespublica.github.io/index.html" target="_blank">
                <span class="nav-icon">🔍</span> Verify ↗
            </a>

            <div class="sidebar-section">System</div>
            <button class="nav-item" onclick="showPanel('dashboard', this)">
                <span class="nav-icon">📊</span> Dashboard
            </button>
            <a class="nav-item" href="http://localhost:8080" target="_blank">
                <span class="nav-icon">🗄️</span> immudb Console ↗
            </a>
        </aside>

        <!-- ── MAIN ── -->
        <div>

            <!-- DASHBOARD -->
            <div class="panel" id="panel-dashboard">
                <div class="panel-header">
                    <div class="panel-icon">📊</div>
                    <div>
                        <div class="panel-title">System Dashboard</div>
                        <div class="panel-subtitle">Live status of the TruthChain stack</div>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="stats-row" style="margin-bottom:1.25rem;">
                        <div class="stat-card"><div class="stat-value" id="dTotal">—</div><div class="stat-label">Total Anchored</div></div>
                        <div class="stat-card" style="border-top:3px solid var(--gold);"><div class="stat-value" style="color:#8a6a14;" id="dLatest">—</div><div class="stat-label">Last Issue</div></div>
                        <div class="stat-card"><div class="stat-value" style="color:#1E7A3E;">✓</div><div class="stat-label">immudb Status</div></div>
                        <div class="stat-card"><div class="stat-value">2026</div><div class="stat-label">Ledger Year</div></div>
                    </div>

                    <div class="civic-section" style="margin-bottom:0;">
                        <span class="civic-section-id">01 — System Status</span>
                        <div class="civic-body" style="max-width:100%;">
                            <p>The ORP Engine is operational. Documents submitted through the PDF Stamp or PhilID Ingest routes are automatically hashed, anchored to the local immudb instance, and published to the public ledger at <em>openrespublica.github.io</em> within 60 to 90 seconds of issuance. All transactions are immutable upon anchoring.</p>
                        </div>
                    </div>

                    <div style="margin-top:1.25rem;">
                        <div class="alert alert-warning">🔒 This portal is restricted to authorized barangay operators only. All access and issuance actions are logged and anchored to the immutable ledger.</div>
                        <div class="alert alert-info">🔗 Public ledger syncs to <strong>openrespublica.github.io</strong> within 60–90 seconds. Records are cryptographically immutable once pushed.</div>
                    </div>
                </div>
            </div>

            <!-- PDF UPLOAD -->
            <div class="panel active" id="panel-upload">
                <div class="panel-header">
                    <div class="panel-icon">📄</div>
                    <div>
                        <div class="panel-title">PDF Stamp &amp; Anchor</div>
                        <div class="panel-subtitle">Upload an existing PDF to hash, stamp, and anchor to the immutable ledger</div>
                    </div>
                </div>
                <div class="panel-body">

                    <div class="civic-section" style="margin-bottom:1.25rem;">
                        <span class="civic-section-id">01 — Upload</span>
                        <div class="civic-body" style="max-width:100%;font-size:0.83rem;">
                            <p>Select a PDF document for cryptographic processing. The system will compute a SHA-256 fingerprint, anchor it to immudb, stamp the document with a QR code and control number, and publish the record to the public ledger automatically.</p>
                        </div>
                    </div>

                    <form id="uploadForm">
                         <div class="form-group">
                             <label class="form-label">Document File</label>
                             <div class="file-drop" id="dropZone" onclick="document.getElementById('pdfFile').click()">
                                 <input type="file" id="pdfFile" name="document" accept=".pdf" style="display:none" onchange="fileSelected(this)" required>
                                 <div class="file-drop-icon">📄</div>
                                 <p><strong>Click to browse</strong> or drag &amp; drop</p>
                                 <p style="margin-top:0.2rem;font-size:0.75rem;">PDF files only &nbsp;·&nbsp; Max 20MB</p>
                                 <span id="selectedFileName" style="display:none;margin-top:0.6rem;font-family:var(--font-mono);font-size:0.75rem;color:#1E7A3E;background:#F0FAF4;padding:3px 10px;border-radius:4px;"></span>
                             </div>
                          </div>

                          <div class="form-group">
                              <label class="form-label">Document Type</label>
                              <select class="form-select" id="uploadDocType" name="doc_type">
                                   <option value="BARANGAY-CERT">Barangay Certificate</option>
                                   <option value="INDIGENCY-CERT">Certificate of Indigency</option>
                                   <option value="RESIDENCY-CERT">Certificate of Residency</option>
                                   <option value="CLEARANCE">Barangay Clearance</option>
                                   <option value="BUSINESS-PERMIT">Business Permit</option>
                                   <option value="DICT-INQUIRY">DICT Inquiry (RA 11337)</option>
                                   <option value="OTHER">Other</option>
                               </select>
                          </div>

                          <div class="form-group">
                              <label class="form-label">Hardware Security Module (HSM) PIN</label>
                                   <input type="password" class="form-input" id="hsmPin" name="hsm_pin_upload" placeholder="Enter PIN to authorize signing" required>
                                   <style="font-family: var(--font-mono); letter-spacing: 0.3em;">
                           
                               <div class="form-hint">Physical ESP32-HSM must be connected for signature verification.</div>
                         </div>

                             <button type="submit" class="btn-submit" id="uploadBtn">🔏 Stamp, Hash &amp; Authorize Sign</button>

                    </form>

                    <form id="uploadForm">
                        <div class="form-group">
                            <label class="form-label">Document File</label>
                            <div class="file-drop" id="dropZone" onclick="document.getElementById('pdfFile').click()">
                                <input type="file" id="pdfFile" accept=".pdf" style="display:none" onchange="fileSelected(this)">
                                <div class="file-drop-icon">📄</div>
                                <p><strong>Click to browse</strong> or drag &amp; drop</p>
                                <p style="margin-top:0.2rem;font-size:0.75rem;">PDF files only &nbsp;·&nbsp; Max 20MB</p>
                                <span id="selectedFileName" style="display:none;margin-top:0.6rem;font-family:var(--font-mono);font-size:0.75rem;color:#1E7A3E;background:#F0FAF4;padding:3px 10px;border-radius:4px;display:none;"></span>
                            </div>
                        </div>


                        <div class="form-group">
                            <label class="form-label">Document Type</label>
                            <select class="form-select" id="uploadDocType">
                                <option value="BARANGAY-CERT">Barangay Certificate</option>
                                <option value="INDIGENCY-CERT">Certificate of Indigency</option>
                                <option value="RESIDENCY-CERT">Certificate of Residency</option>
                                <option value="CLEARANCE">Barangay Clearance</option>
                                <option value="BUSINESS-PERMIT">Business Permit</option>
                                <option value="DICT-INQUIRY">DICT Inquiry (RA 11337)</option>
                                <option value="OTHER">Other</option>
                            </select>
                        </div>
                        <button type="submit" class="btn-submit" id="uploadBtn">🔏 Stamp, Hash &amp; Anchor to Ledger</button>
                    </form>

                    <form action="/upload" method="post" enctype="multipart/form-data">
                        <input type="file" name="document" required>
                        <select name="doc_type">
                            <option value="BARANGAY-CERT">Barangay Certificate</option>
                            <option value="CLEARANCE">Barangay Clearance</option>
                        </select>
    
                        <input type="password" name="hsm_pin" placeholder="Enter HSM PIN" required>
    
                        <button type="submit">Verify & Sign</button>
                    </form>

                    <div class="progress-wrap" id="uploadProgress">
                        <div class="progress-steps">
                            <div class="progress-step" id="us1">Hashing</div>
                            <div class="progress-step" id="us2">Anchoring</div>
                            <div class="progress-step" id="us3">Stamping</div>
                            <div class="progress-step" id="us4">Publishing</div>
                        </div>
                        <div class="progress-bar-wrap"><div class="progress-bar" id="uploadBar"></div></div>
                    </div>
                    <div class="result-box" id="uploadResult"></div>
                </div>
            </div>

            <!-- PHILID INGEST -->
            <div class="panel" id="panel-ingest">
                <div class="panel-header">
                    <div class="panel-icon">🪪</div>
                    <div>
                        <div class="panel-title">PhilID Sovereign Ingest</div>
                        <div class="panel-subtitle">Auto-generate a barangay certificate from a PhilID JSON payload</div>
                    </div>
                </div>
                <div class="panel-body">

                    <div class="civic-section" style="margin-bottom:1.25rem;">
                        <span class="civic-section-id">01 — Sovereign Pipeline</span>
                        <div class="civic-body" style="max-width:100%;font-size:0.83rem;">
                            <p>Paste the JSON payload received from the PhilID mobile scan. The system will automatically populate the barangay certificate template, convert it to PDF via LibreOffice Headless, compute the SHA-256 fingerprint, anchor it to immudb, stamp the document, and publish it to the public ledger — all without manual data entry.</p>
                        </div>
                    </div>

                    <form id="ingestForm">
                        <div class="form-group">
                            <label class="form-label">PhilID JSON Payload</label>
                            <textarea class="form-textarea" id="philidPayload" placeholder='{"subject":{"fName":"Juan","mName":"dela","lName":"Cruz",...},"alg":"ES256","signature":"..."}'></textarea>
                            <div class="form-hint">Paste the raw JSON payload from the PhilID scanner or QR scan result. Sensitive data never leaves this server.</div>
                        </div>
                        <div class="form-grid">
                            <div class="form-group">
                                <label class="form-label">Purok / Address</label>
                                <input type="text" class="form-input" id="ingestPurok" value="Purok San Lorenzo" placeholder="e.g. Purok San Lorenzo">
                            </div>
                            <div class="form-group">
                                <label class="form-label">Purpose of Certificate</label>
                                <select class="form-select" id="ingestPurpose">
                                    <option value="BARANGAY-CERT">Barangay Certificate</option>
                                    <option value="INDIGENCY-CERT">Certificate of Indigency</option>
                                    <option value="RESIDENCY-CERT">Certificate of Residency</option>
                                    <option value="CLEARANCE">Barangay Clearance</option>
                                    <option value="EMPLOYMENT">Employment Purpose</option>
                                    <option value="SCHOLARSHIP">Scholarship Application</option>
                                    <option value="LOAN">Loan Application</option>
                                    <option value="TRAVEL">Travel Purpose</option>
                                    <option value="OTHER">Other / General Purpose</option>
                                </select>
                            </div>
                        </div>
                        <div class="or-divider">or load sample data</div>
                        <button type="button" class="btn-ghost" onclick="fillSample()">📋 Load Sample PhilID Payload</button>
                        <button type="submit" class="btn-submit" id="ingestBtn">🪪 Generate Certificate &amp; Anchor to Ledger</button>
                    </form>

                    <div class="progress-wrap" id="ingestProgress">
                        <div class="progress-steps">
                            <div class="progress-step" id="is1">Parsing</div>
                            <div class="progress-step" id="is2">Generating</div>
                            <div class="progress-step" id="is3">Converting</div>
                            <div class="progress-step" id="is4">Anchoring</div>
                            <div class="progress-step" id="is5">Publishing</div>
                        </div>
                        <div class="progress-bar-wrap"><div class="progress-bar" id="ingestBar"></div></div>
                    </div>
                    <div class="result-box" id="ingestResult"></div>
                </div>
            </div>

            <!-- LEDGER -->
            <div class="panel" id="panel-ledger">
                <div class="panel-header">
                    <div class="panel-icon">📋</div>
                    <div>
                        <div class="panel-title">Local Ledger</div>
                        <div class="panel-subtitle">Most recent anchored records from the public manifest</div>
                    </div>
                </div>
                <div style="overflow-x:auto;">
                    <table>
                        <thead>
                            <tr>
                                <th>Control No.</th>
                                <th>Type</th>
                                <th>Timestamp</th>
                                <th>Fingerprint</th>
                                <th>Tx ID</th>
                                <th style="text-align:center;">Action</th>
                            </tr>
                        </thead>
                        <tbody id="ledgerBody">
                            <tr><td colspan="6" style="text-align:center;padding:2rem;color:var(--muted);">
                                <div class="spinner"></div>Loading...
                            </td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="table-footer">
                    <span id="ledgerCount">—</span>
                    <div style="display:flex;gap:0.35rem;">
                        <button class="page-btn" id="lPrev" onclick="lChangePage(-1)" disabled>← Prev</button>
                        <button class="page-btn" id="lNext" onclick="lChangePage(1)" disabled>Next →</button>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <footer class="site-footer">
        OpenResPublica TruthChain &nbsp;·&nbsp; ORP Engine Operator Portal &nbsp;·&nbsp;
        Barangay Buñao, Dumaguete City &nbsp;·&nbsp; Secured by immudb &amp; Ed25519
    </footer>

    <script>
        // ── NAV ──
        function showPanel(id, el) {
            document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
            document.getElementById('panel-' + id).classList.add('active');
            if (el) el.classList.add('active');
            if (id === 'ledger') loadLedger();
            if (id === 'dashboard') loadDashboard();
        }

        // ── FILE DROP ──
        const dropZone = document.getElementById('dropZone');
        dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('dragover'); });
        dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
        dropZone.addEventListener('drop', e => {
            e.preventDefault(); dropZone.classList.remove('dragover');
            const file = e.dataTransfer.files[0];
            if (file?.name.endsWith('.pdf')) { document.getElementById('pdfFile').files = e.dataTransfer.files; fileSelected({files:[file]}); }
        });

        function fileSelected(input) {
            const file = input.files[0]; if (!file) return;
            const el = document.getElementById('selectedFileName');
            el.textContent = `✓ ${file.name} (${(file.size/1024).toFixed(1)} KB)`;
            el.style.display = 'inline-block';
        }

        // ── PROGRESS ──
        function setStep(prefix, step, total) {
            for (let i = 1; i <= total; i++) {
                const el = document.getElementById(prefix + i); if (!el) continue;
                el.className = 'progress-step' + (i < step ? ' done' : i === step ? ' active' : '');
            }
            const barId = prefix === 'us' ? 'uploadBar' : 'ingestBar';
            const bar = document.getElementById(barId);
            if (bar) bar.style.width = `${Math.min(100, (step/total)*100)}%`;
        }

        function showResult(id, ok, title, details, blob, filename) {
            const el = document.getElementById(id);
            el.className = 'result-box ' + (ok ? 'result-success' : 'result-error');
            el.style.display = 'block';
            let dHtml = '';
            if (details && typeof details === 'object') {
                dHtml = '<div class="result-kv">' + Object.entries(details).map(([k,v]) =>
                    `<span class="result-key">${k}</span><span class="result-val">${v}</span>`
                ).join('') + '</div>';
            } else if (details) dHtml = `<p style="margin-top:0.5rem;">${details}</p>`;
            let dlHtml = '';
            if (blob && filename) { const url = URL.createObjectURL(blob); dlHtml = `<a href="${url}" download="${filename}" class="download-btn">⬇ Download ${filename}</a>`; }
            el.innerHTML = `<div class="result-header"><h4>${ok?'✅':'❌'} ${title}</h4></div><div class="result-body">${dHtml}${dlHtml}</div>`;
        }

        // ── UPLOAD ──
        document.getElementById('uploadForm').addEventListener('submit', async e => {
            e.preventDefault();
            const file = document.getElementById('pdfFile').files[0];
            const hsmPin = document.getElementById('hsm_pin_upload').value; // Get the PIN
            const docType = document.getElementById('uploadDocType').value;

            if (!file || !hsmPin) { alert('Please select a file and enter your HSM PIN.'); return; }      
            if (!file) { alert('Please select a PDF file.'); return; }
            const docType = document.getElementById('uploadDocType').value;
            const btn = document.getElementById('uploadBtn');
            btn.disabled = true;
            document.getElementById('uploadProgress').style.display = 'block';
            document.getElementById('uploadResult').style.display = 'none';
            [1,2,3].forEach((s,i) => setTimeout(() => setStep('us',s,4), i*700+100)); 
            const fd = new FormData();
            fd.append('document', file);
            fd.append('doc_type', docType);
            fd.append('hsm_pin', hsmPin); // Pass PIN to Python bridge
            fd.append('hsm_pin', document.getElementById('hsmPin').value); // Add this line


            try {
                const res = await fetch('/upload', { method:'POST', body:fd });
                const result = await res.json();
                setStep('us',4,4);
                if (res.ok) {
                    const blob = await res.blob();
                    const ctrl = res.headers.get('Content-Disposition')?.match(/filename="?([^"]+)"?/)?.[1] || `${docType}.pdf`;
                    showResult('uploadResult', true, 'Document Anchored to TruthChain', showResult('uploadResult', true, 'Success', {'Fingerprint': result.hash, 'Signature': result.signature, 'Control No': result.control_no });
                        {'File': file.name, 'Type': docType, 'Status': 'Anchored · Publishing to ledger...'}, blob, ctrl);
                } else { showResult('uploadResult', false, 'Hardware Auth Failed', result.message); }
                } else { showResult('uploadResult', false, 'Upload Failed', await res.text()); }
            } catch(err) { showResult('uploadResult', false, 'Connection Error', err.message); }
            finally { btn.disabled = false; setTimeout(() => { document.getElementById('uploadProgress').style.display='none'; setStep('us',0,4); }, 3500); }
        });

        // ── SAMPLE ──
        function fillSample() {
            document.getElementById('philidPayload').value = JSON.stringify({
                subject: { fName:"Juan", mName:"dela", lName:"Cruz", Suffix:"", sex:"Male", DOB:"1990-01-15", POB:"Dumaguete City, Negros Oriental", PCN:"1234-5678-9012-3456" },
                alg: "ES256", signature: "SAMPLE-PSA-SIG-ABCDEF123456"
            }, null, 2);
        }

        // ── INGEST ──
        document.getElementById('ingestForm').addEventListener('submit', async e => {
            e.preventDefault();
            const raw = document.getElementById('philidPayload').value.trim();
            if (!raw) { alert('Please paste a PhilID JSON payload.'); return; }
            let parsed; try { parsed = JSON.parse(raw); } catch { alert('Invalid JSON.'); return; }
            const btn = document.getElementById('ingestBtn'); btn.disabled = true;
            document.getElementById('ingestProgress').style.display = 'block';
            document.getElementById('ingestResult').style.display = 'none';
            [1,2,3,4].forEach((s,i) => setTimeout(() => setStep('is',s,5), [100,700,2200,4000][i]));
            try {
                const res = await fetch('/ingest', {
                    method:'POST', headers:{'Content-Type':'application/json'},
                    body: JSON.stringify({ payload: JSON.stringify(parsed), purok: document.getElementById('ingestPurok').value, purpose: document.getElementById('ingestPurpose').value })
                });
                setStep('is',5,5);
                if (res.ok) {
                    const blob = await res.blob();
                    const ctrl = res.headers.get('Content-Disposition')?.match(/filename="?([^"]+)"?/)?.[1] || 'certificate.pdf';
                    const s = parsed.subject || {};
                    showResult('ingestResult', true, 'Certificate Generated &amp; Anchored',
                        {'Name': `${s.fName||''} ${s.mName||''} ${s.lName||''}`.trim(), 'PCN': s.PCN||'—', 'Status':'Anchored · Publishing to ledger...'}, blob, ctrl);
                } else { const d = await res.json().catch(()=>({message:'Unknown error'})); showResult('ingestResult', false, 'Ingest Failed', d.message); }
            } catch(err) { showResult('ingestResult', false, 'Connection Error', err.message); }
            finally { btn.disabled = false; setTimeout(() => { document.getElementById('ingestProgress').style.display='none'; setStep('is',0,5); }, 4000); }
        });

        // ── LEDGER ──
        let lData=[], lPage=1; const LP=15;
        async function loadLedger() {
            document.getElementById('ledgerBody').innerHTML = '<tr><td colspan="6" style="text-align:center;padding:1.5rem;color:var(--muted);"><div class="spinner" style="margin:0 auto 0.5rem;"></div>Loading...</td></tr>';
            try {
                const res = await fetch('https://openrespublica.github.io/records/manifest.json?t='+Date.now());
                if (!res.ok) throw new Error();
                lData = (await res.json()).reverse();
                lRender();
            } catch { document.getElementById('ledgerBody').innerHTML = '<tr><td colspan="6" style="text-align:center;padding:1.5rem;color:var(--muted);">Could not load manifest.</td></tr>'; }
        }

        function lRender() {
            const total=lData.length, start=(lPage-1)*LP, end=Math.min(start+LP,total), slice=lData.slice(start,end);
            document.getElementById('ledgerBody').innerHTML = slice.map(r => `
                <tr>
                    <td><strong style="font-size:0.78rem;color:var(--navy-mid);">${r.control_number||'—'}</strong></td>
                    <td><span class="badge-type">${r.document_type||'GENERAL'}</span></td>
                    <td style="font-size:0.75rem;color:var(--muted);">${r.timestamp||'—'}</td>
                    <td><span class="mono">${(r.sha256_hash||'').substring(0,14)}...</span></td>
                    <td><span class="mono">#${r.immudb_transaction_id||'—'}</span></td>
                    <td style="text-align:center;"><a href="https://openrespublica.github.io/index.html?hash=${r.sha256_hash}" target="_blank" class="btn-outline">Verify</a></td>
                </tr>`).join('');
            document.getElementById('ledgerCount').textContent = `Showing ${start+1}–${end} of ${total} records`;
            document.getElementById('lPrev').disabled = lPage===1;
            document.getElementById('lNext').disabled = end>=total;
        }

        function lChangePage(d) { lPage = Math.max(1,Math.min(lPage+d,Math.ceil(lData.length/LP))); lRender(); }

        // ── DASHBOARD ──
        async function loadDashboard() {
            try {
                const res = await fetch('https://openrespublica.github.io/records/manifest.json?t='+Date.now());
                if (!res.ok) return;
                const data = await res.json();
                document.getElementById('dTotal').textContent = data.length;
                if (data.length) document.getElementById('dLatest').textContent = ([...data].reverse()[0].timestamp||'').split(' ')[0]||'—';
            } catch {}
        }

        loadDashboard();
    </script>
</body>
</html>
